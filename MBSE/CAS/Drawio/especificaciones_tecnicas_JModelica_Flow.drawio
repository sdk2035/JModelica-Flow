        </mxCell>
        <mxCell id="9dhFhsiPX3KU6t1QtFho-3" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#94a3b8;" value="PROYECTO COMPLEMENTARIO: JModelica-Flow — Interfaz Visual Low-Code para Modelado Dinámico y Monitoreo" vertex="1">
          <mxGeometry height="20" width="1480" x="60" y="72" as="geometry" />
        </mxCell>
        <mxCell id="9dhFhsiPX3KU6t1QtFho-4" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#f8fafc;strokeColor=#0284c7;strokeWidth=2;fontStyle=1;fontSize=14;fontColor=#0369a1;" value="1. REQUISITOS FUNCIONALES (RF)" vertex="1">
          <mxGeometry height="420" width="480" x="40" y="140" as="geometry" />
        </mxCell>
        <mxCell id="9dhFhsiPX3KU6t1QtFho-5" parent="9dhFhsiPX3KU6t1QtFho-4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#bae6fd;align=left;spacingLeft=10;fontSize=11;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;RF-01: Lienzo Visual Drag-and-Drop&lt;/b&gt;&lt;br&gt;• Arrastre y conexión visual de bloques físicos.&lt;br&gt;• Biblioteca libre (tanques H2, celdas, convertidores DC/DC, rotores)." vertex="1">
          <mxGeometry height="75" width="440" x="20" y="45" as="geometry" />
        </mxCell>
        <mxCell id="9dhFhsiPX3KU6t1QtFho-6" parent="9dhFhsiPX3KU6t1QtFho-4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#bae6fd;align=left;spacingLeft=10;fontSize=11;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;RF-02: Binding Reactivo en Tiempo Real&lt;/b&gt;&lt;br&gt;• Modificación de parámetros (presión H2, carga de batería) con sliders/dials.&lt;br&gt;• Sincronización continua de variables sin reiniciar el kernel." vertex="1">
          <mxGeometry height="75" width="440" x="20" y="130" as="geometry" />
        </mxCell>
        <mxCell id="9dhFhsiPX3KU6t1QtFho-7" parent="9dhFhsiPX3KU6t1QtFho-4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#bae6fd;align=left;spacingLeft=10;fontSize=11;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;RF-03: Compilación Automática a PyJMI&lt;/b&gt;&lt;br&gt;• Generación automática de scripts de ejecución en Python (pyjmi).&lt;br&gt;• Traducción transparente del diagrama visual a código ejecutable." vertex="1">
          <mxGeometry height="75" width="440" x="20" y="215" as="geometry" />
        </mxCell>
        <mxCell id="9dhFhsiPX3KU6t1QtFho-8" parent="9dhFhsiPX3KU6t1QtFho-4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#bae6fd;align=left;spacingLeft=10;fontSize=11;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;RF-04: Dashboard No-Code Integrado&lt;/b&gt;&lt;br&gt;• Visualizadores gráficos e indicadores térmicos y eléctricos.&lt;br&gt;• Generación instantánea de gráficas Plotly (consumo vs. autonomía)." vertex="1">
          <mxGeometry height="75" width="440" x="20" y="300" as="geometry" />
        </mxCell>
        <mxCell id="9dhFhsiPX3KU6t1QtFho-9" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#f8fafc;strokeColor=#059669;strokeWidth=2;fontStyle=1;fontSize=14;fontColor=#047857;" value="2. REQUISITOS NO FUNCIONALES (RNF)" vertex="1">
          <mxGeometry height="420" width="480" x="560" y="140" as="geometry" />
        </mxCell>
        <mxCell id="9dhFhsiPX3KU6t1QtFho-10" parent="9dhFhsiPX3KU6t1QtFho-9" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#a7f3d0;align=left;spacingLeft=10;fontSize=11;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;RNF-01: Reactividad de Baja Latencia&lt;/b&gt;&lt;br&gt;• Sincronización de estado instantánea basada en patrón Genie/Stipple.&lt;br&gt;• Actualización de gráficos sin retardo apreciable para la UI." vertex="1">
          <mxGeometry height="75" width="440" x="20" y="45" as="geometry" />
        </mxCell>
        <mxCell id="9dhFhsiPX3KU6t1QtFho-11" parent="9dhFhsiPX3KU6t1QtFho-9" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#a7f3d0;align=left;spacingLeft=10;fontSize=11;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;RNF-02: Usabilidad Low-Code / No-Code&lt;/b&gt;&lt;br&gt;• Abstracción del código Python/pyjmi para usuarios no programadores.&lt;br&gt;• Interfaz intuitiva inspirada en motores de flujo de nodos." vertex="1">
          <mxGeometry height="75" width="440" x="20" y="130" as="geometry" />
        </mxCell>
        <mxCell id="9dhFhsiPX3KU6t1QtFho-12" parent="9dhFhsiPX3KU6t1QtFho-9" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#a7f3d0;align=left;spacingLeft=10;fontSize=11;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;RNF-03: Modularidad de Biblioteca de Componentes&lt;/b&gt;&lt;br&gt;• Arquitectura extensible para añadir bloques dinámicos personalizados.&amp;br&gt;• Soporte nativo para sistemas de propulsión eléctrica e hidrógeno." vertex="1">
          <mxGeometry height="75" width="440" x="20" y="215" as="geometry" />
        </mxCell>
        <mxCell id="9dhFhsiPX3KU6t1QtFho-13" parent="9dhFhsiPX3KU6t1QtFho-9" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#a7f3d0;align=left;spacingLeft=10;fontSize=11;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;RNF-04: Portabilidad y Licencia Libre&lt;/b&gt;&lt;br&gt;• Núcleo 100% Open-Source desplegable en entono local o servidor web.&amp;br&gt;• Compatibilidad directa con scripts JModelica estándar." vertex="1">
          <mxGeometry height="75" width="440" x="20" y="300" as="geometry" />
        </mxCell>
        <mxCell id="9dhFhsiPX3KU6t1QtFho-14" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#f8fafc;strokeColor=#7c3aed;strokeWidth=2;fontStyle=1;fontSize=14;fontColor=#5b21b6;" value="3. ARQUITECTURA TÉCNICA LOW-CODE" vertex="1">
